# ============================================================================
# Bhargavi Health World — BACKEND environment template
# ============================================================================
#
# Copy to .env.local for local work. For deployed environments, set real values
# in RAILWAY → Service → Variables. Never in a file.
#
#   ⚠ NEVER commit .env or .env.local, or any file containing a real value.
#   ⚠ Names and SAFE PLACEHOLDERS only in this file.
#   ⚠ NEVER prefix a secret with NEXT_PUBLIC_ — that makes it browser-visible.
#
# Approved stack (D-019):  Frontend → Vercel · Backend → Railway
#                          Database → Neon PostgreSQL · Media → Cloudinary
#
# Canonical map with per-environment guidance, secrecy class and rotation
# requirements: docs/MASTER-IMPLEMENTATION-BLUEPRINT.md §F.1
# This file is governed by D-034.
#
# ── Deliberately ABSENT, and must stay absent ───────────────────────────────
#   CONTACT_TO_EMAIL / CONTACT_TO_EMAIL_CHIKKADPALLY /
#   CONTACT_TO_EMAIL_BOWENPALLY / CAREERS_TO_EMAIL
#       → FORBIDDEN by D-020. Notification destinations are DATABASE ROW
#         VALUES, not deployment config:
#             branches.notify_email          (per branch)
#             site_settings.default_notify_email
#             site_settings.careers_notify_email
#         They are seeded once and edited in the admin panel thereafter, so a
#         real per-branch address needs no code change and no redeploy.
#         A grep for the clinic's address in src/ must return ZERO hits
#         outside the seed script.
#   STORAGE_PROVIDER / STORAGE_ENDPOINT / STORAGE_REGION /
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY /
#   STORAGE_BUCKET_PUBLIC / STORAGE_BUCKET_PRIVATE / STORAGE_PUBLIC_BASE_URL
#       → Cloudflare R2. SUPERSEDED by D-018 (Cloudinary).
#   REVALIDATE_URL / REVALIDATE_SECRET
#       → REMOVED by D-016. There is no /api/revalidate route and no ISR;
#         a Vercel Deploy Hook replaces both.
#   NEXT_PUBLIC_API_URL
#       → Not needed. The browser NEVER calls this backend directly; the
#         frontend proxies /api/contact server-to-server (D-002 + D-016).
#   ANALYTICS_MEASUREMENT_ID
#       → It is site_settings.analytics_measurement_id, an admin-editable
#         column. Stays NULL until C-15 is answered.
# ============================================================================


# ── 1. RUNTIME ──────────────────────────────────────────────────────────────
# Not secret.

NODE_ENV=development
LOG_LEVEL=debug
# Public origin of THIS backend. No trailing slash. Used for absolute links in
# notification emails and for admin deep links.
APP_URL=http://localhost:3001


# ── 2. DATABASE — Neon PostgreSQL (D-017) ───────────────────────────────────
# SECRET. Two connection strings are REQUIRED, not optional.
#
#   DATABASE_URL           POOLED endpoint (the "-pooler" host) — ALL
#                          application queries. Neon's pooler is PgBouncer in
#                          TRANSACTION mode, so server-side prepared
#                          statements MUST be disabled in the driver
#                          (?pgbouncer=true / prepare:false /
#                          statement_cache_size=0, depending on the driver).
#                          Leaving them on produces intermittent
#                          'prepared statement "s1" already exists' errors
#                          under concurrency that look like a random bug.
#                          Also unavailable on this endpoint: LISTEN/NOTIFY,
#                          session-level advisory locks, session SET, temp
#                          tables, DDL.
#
#   DATABASE_URL_UNPOOLED  DIRECT endpoint — migrations, DDL and the seed
#                          script ONLY. Must never be used by a request path.
#
# Use a separate Neon BRANCH per environment (dev / staging / production).
# Production must have PITR enabled, with a RESTORE DRILL performed before any
# production data exists — and that drill must include decrypting a real
# submissions.message row (D-035).

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require


# ── 3. AUTH AND CRYPTO ──────────────────────────────────────────────────────
# SECRET. Generate locally; never reuse a value between environments.

# Session signing / derivation. 32 bytes, base64.
#   openssl rand -base64 32
SESSION_SECRET=GENERATE_32_BYTES_BASE64

# ── Field encryption for submissions.message (D-035) ────────────────────────
# submissions.message holds free-text patient symptom descriptions. It is
# stored ONLY as AES-256-GCM authenticated ciphertext, encrypted and decrypted
# in the application layer. The key NEVER reaches the database, so a database
# dump alone is unreadable.
#
#   FIELD_ENCRYPTION_KEYS         EVERY key that may be needed to DECRYPT,
#                                 as comma-separated `version:base64key`
#                                 pairs. Each key is 32 bytes → 44 base64
#                                 characters.  openssl rand -base64 32
#   FIELD_ENCRYPTION_KEY_ACTIVE   The version used for NEW writes. Must name a
#                                 version present in the map above.
#
# ROTATION: add a new version, then point _ACTIVE at it. Old rows keep
# decrypting under the key version embedded in their own envelope — no flag
# day, no downtime, no bulk re-encryption required. Retire an old version only
# after a query proves zero rows still reference it.
#
# 🔴 BACKUP: database backups and PITR contain CIPHERTEXT ONLY. A successful
#    restore produces unreadable messages unless this key map is restored too,
#    and it is deliberately not in the database. Back it up SEPARATELY in the
#    platform secret store and document the recovery procedure in
#    docs/RUNBOOK-restore.md.
#
# The container REFUSES TO START if the map is missing, unparseable, contains a
# key that is not exactly 32 bytes, or if _ACTIVE names an absent version.

FIELD_ENCRYPTION_KEYS=v1:GENERATE_32_BYTES_BASE64
FIELD_ENCRYPTION_KEY_ACTIVE=v1


# ── 4. MEDIA — Cloudinary (D-018 / D-014) ───────────────────────────────────
# CLOUDINARY_API_SECRET is SECRET and signs upload parameters. It must never
# reach the browser.
#
# Public site media:  delivery_type=upload,        resource_type=image
# Resumes / CVs:      delivery_type=authenticated, resource_type=raw
#                     → no public URL exists at all; media.secure_url is NULL;
#                       delivery is via short-lived signed URLs only (≤5 min),
#                       audited on every download.
#
# 🔴 NEVER create or use an UNSIGNED UPLOAD PRESET — anyone could upload to the
#    account. All constraints (allowed_formats, max_bytes, public_id,
#    resource_type, type) live INSIDE the signed parameters and are never
#    trusted from the client. Post-upload Admin API verification is MANDATORY,
#    plus a bounded magic-byte check for raw resumes (D-031).
#
# 🔴 The public delivery host res.cloudinary.com MUST be added to the
#    FRONTEND's next.config.ts images.remotePatterns before any uploaded image
#    is referenced, or every next/image render throws. Single hardest
#    cross-repo dependency in the project.

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=GENERATE_OR_COPY_FROM_CLOUDINARY_CONSOLE


# ── 5. EMAIL — 🔴 REMOVED. THERE IS NOTHING TO CONFIGURE ────────────────────
#
# D-038: the client does not want the website to email patients, clinic staff
# or administrators. All outbound mail was REMOVED — the `resend` dependency,
# src/lib/mail/, and these three variables:
#
#     RESEND_API_KEY        MAIL_FROM        ALERT_TO_EMAIL
#
# 🔴 All three are now in FORBIDDEN_ENV_VARS. Setting ANY of them is a BOOT
#    FAILURE, not a no-op. That is deliberate: leaving them merely unread would
#    mean a future session could restore one line of code, find a live key
#    already sitting in Railway, and start emailing patients again.
#
# How the clinic learns about a new enquiry, now:
#   1. WhatsApp — the visitor's own message arrives the moment they submit.
#      This was always the primary channel and is untouched (D-009 / D-030).
#   2. The admin dashboard at /admin — the record, with the full history.
#
# Operational alerts (encryption failure, deploy-hook failure) go to the SERVER
# LOG only. Whoever runs the deployment has to watch Railway's logs; nothing
# surfaces them in the dashboard.
#
# Do NOT add a replacement provider without a new decision superseding D-038.


# ── 6. FRONTEND INTEGRATION (D-002 / D-016) ─────────────────────────────────
# BACKEND_API_KEY is SECRET and server-only on BOTH sides.

# CORS allowlist base. The allowlist is a FUNCTION, not a constant: this origin
# plus a Vercel preview PATTERN (/^https:\/\/[a-z0-9-]+\.vercel\.app$/).
# NEVER "*". Note the /api/contact proxy is server-to-server and therefore not
# subject to CORS — this must not be relied on as an auth boundary.
FRONTEND_ORIGIN=http://localhost:3000

# Shared key used by (a) the frontend's /api/contact proxy and (b) the
# frontend's PREBUILD CONTENT GENERATOR. It also exempts the build egress from
# the public GET rate limit, so a rebuild cannot rate-limit itself.
# Server-side only — must NEVER be NEXT_PUBLIC_*.
BACKEND_API_KEY=GENERATE_32_BYTES_BASE64

# 🔴 Vercel Deploy Hook — SECRET URL. The backend POSTs here after any
#    successful content mutation; Vercel rebuilds; the prebuild generator
#    regenerates src/content/*.ts and src/lib/site.ts; the site goes live in
#    ~1–2 min. Debounced 30–60 s, retried, then LOGGED AND ALERTED on failure
#    (a silent failure means editors change content and watch nothing move).
#
#    Treat as a CAPABILITY: anyone holding this URL can trigger a build.
#    Server-side only, never logged, rotate if leaked.
#
# 🔴 A STAGING backend holding the PRODUCTION hook URL would rebuild the live
#    site from staging data. Scope each hook to its own Vercel project.
VERCEL_DEPLOY_HOOK_URL=


# ── 7. RATE LIMITING ────────────────────────────────────────────────────────
# Optional. If unset, falls back to the rate_limit_hits table.
# REDIS_URL is SECRET when set.
#
# Limits: /api/contact 5/10min per IP · /api/applications 3/10min per IP ·
#         /api/admin/login 5/15min per IP+email · public GETs 120/min ·
#         authenticated admin 600/min.
#
# ⚠ The limiter FAILS OPEN on /api/contact (P-015): if the store is
#   unavailable the submission is ALLOWED and logged loudly. A lost patient
#   lead is worse than a duplicate.
#
# ⚠ Railway sits behind a proxy. The client IP comes from X-Forwarded-For and
#   the extraction must be verified against Railway's current documented
#   behaviour, or every visitor shares one bucket and the limiter either locks
#   the whole clinic out or does nothing.

REDIS_URL=


# ============================================================================
# FRONTEND (bhargavi-fronted) — for reference. Set these in VERCEL.
# ============================================================================
#
#   NEXT_PUBLIC_SITE_URL   PUBLIC. Drives metadataBase, canonical tags,
#                          sitemap.xml and robots.txt. No trailing slash.
#                          ⚠ Must be correct PER ENVIRONMENT or canonicals
#                            break on preview deployments.
#                          ⚠ The generator must re-emit site.url as the
#                            EXPRESSION
#                              process.env.NEXT_PUBLIC_SITE_URL ?? "<literal>"
#                            and must NOT bake in a literal.
#
#   BACKEND_URL            SERVER-ONLY. Used by the /api/contact proxy and by
#                          the prebuild content generator. Never
#                          NEXT_PUBLIC_*.
#                          ⚠ Vercel PREVIEW deployments must point at the
#                            STAGING backend — a preview must never write to
#                            the production database.
#
#   BACKEND_API_KEY        SERVER-ONLY. Same value as §6 above.
#
# The frontend's own .env.example once carried commented-out RESEND_API_KEY and
# CONTACT_TO_EMAIL lines. Both are gone from it: there is no mail anywhere in
# the project (D-038), and CONTACT_TO_EMAIL is forbidden entirely (D-020/D-034).
# The frontend needs exactly three variables — the two above plus
# NEXT_PUBLIC_SITE_URL.
# ============================================================================
